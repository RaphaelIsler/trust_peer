{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build: app (web)",
            "type": "shell",
            "command": "cargo",
            "args": ["build", "-p", "app", "--features", "web", "--bin", "web"],
            "group": "build",
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Build: app (server)",
            "type": "shell",
            "command": "cargo",
            "args": ["build", "-p", "app", "--features", "server", "--bin", "server"],
            "group": "build",
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Serve: app (desktop)",
            "type": "shell",
            "command": "dx",
            "args": ["serve", "--bin", "desktop", "--features", "desktop", "--platform", "desktop"],
            "options": {"cwd": "${workspaceFolder}/packages/app"},
            "group": "build",
            "isBackground": true,
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Build: app (desktop)",
            "type": "shell",
            "command": "dx",
            "args": ["build", "--bin", "desktop", "--features", "desktop", "--platform", "desktop"],
            "options": {"cwd": "${workspaceFolder}/packages/app"},
            "group": "build",
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Build: app (desktop, release)",
            "type": "shell",
            "command": "dx",
            "args": ["build", "--bin", "desktop", "--features", "desktop", "--platform", "desktop", "--release"],
            "options": {"cwd": "${workspaceFolder}/packages/app"},
            "group": "build",
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Build: app (mobile)",
            "type": "shell",
            "command": "dx",
            "args": ["build", "--bin", "mobile", "--features", "mobile", "--platform", "android"],
            "options": {"cwd": "${workspaceFolder}/packages/app"},
            "group": "build",
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Build: blockchain",
            "type": "shell",
            "command": "cargo",
            "args": ["build", "-p", "blockchain"],
            "group": "build",
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Build: crypto",
            "type": "shell",
            "command": "cargo",
            "args": ["build", "-p", "crypto"],
            "group": "build",
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Build: users",
            "type": "shell",
            "command": "cargo",
            "args": ["build", "-p", "users"],
            "group": "build",
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Build: All Packages",
            "type": "shell",
            "command": "cargo",
            "args": ["build", "--workspace"],
            "group": {"kind": "build"},
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Test: crypto",
            "type": "shell",
            "command": "cargo",
            "args": ["test", "-p", "crypto"],
            "group": "test",
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Test: users",
            "type": "shell",
            "command": "cargo",
            "args": ["test", "-p", "users"],
            "group": "test",
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Test: blockchain",
            "type": "shell",
            "command": "cargo",
            "args": ["test", "-p", "blockchain"],
            "group": "test",
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Test: All Packages",
            "type": "shell",
            "command": "cargo",
            "args": ["test", "--workspace"],
            "group": {"kind": "test", "isDefault": true},
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Build: p2p_webrtc signaling_server",
            "type": "shell",
            "command": "cargo",
            "args": ["build", "-p", "p2p_webrtc", "--bin", "signaling_server"],
            "group": "build",
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Setup P2P Test Environment",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/scripts/start_p2p_test.sh",
            "presentation": {"reveal": "always", "panel": "new"},
            "isBackground": true,
            "runOptions": {"runOn": "folderOpen"},
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*)$",
                    "file": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "🔨 Building binaries...",
                    "endsPattern": "To stop:"
                }
            }
        }
    ]
}
